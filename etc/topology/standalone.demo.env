# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# This demo environment MUST use a dedicated PostgreSQL schema/user `sdkwork_voice_demo` and a
# dedicated Redis prefix `voice-demo` on a distinct logical DB index so no cache key (session,
# rate-limit, transcription/media idempotency) collides with another env sharing the deployment Redis.
SDKWORK_VOICE_DEPLOYMENT_PROFILE=standalone
SDKWORK_VOICE_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_VOICE_PROFILE_ID=standalone.demo
SDKWORK_VOICE_APPLICATION_PUBLIC_HTTP_URL=https://voice-demo.sdkwork.com
VOICE_API_BIND=127.0.0.1:8080
VITE_SDKWORK_VOICE_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:8080


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_VOICE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_CORS_ALLOWED_ORIGINS=https://voice-demo.sdkwork.com,http://voice-demo.sdkwork.com,https://voice-demo.birdcoder.com,http://voice-demo.birdcoder.com,https://voice-demo.dtupay.com,http://voice-demo.dtupay.com,https://voice-demo.noaper.com,http://voice-demo.noaper.com,https://voice-demo.sdkwork.cn,http://voice-demo.sdkwork.cn,https://voice-demo.birdcoder.cn,http://voice-demo.birdcoder.cn,https://voice-demo.dtupay.cn,http://voice-demo.dtupay.cn,https://voice-demo.noaper.cn,http://voice-demo.noaper.cn,https://voice-demo.skubc.com,http://voice-demo.skubc.com,https://voice-demo.skubc.cn,http://voice-demo.skubc.cn,https://voice-demo.zowalk.com,http://voice-demo.zowalk.com,https://voice-demo.zowalk.cn,http://voice-demo.zowalk.cn,https://voice-demo.offer86.com,http://voice-demo.offer86.com,https://voice-demo.offer86.cn,http://voice-demo.offer86.cn,https://voice-demo.86offer.com,http://voice-demo.86offer.com,https://voice-demo.86offer.cn,http://voice-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
