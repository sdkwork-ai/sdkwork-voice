{
  "schemaVersion": "2026-06-06.sdkwork.workflow.v1",
  "app": {
    "id": "sdkwork-voice",
    "name": "SDKWork Voice",
    "repository": "sdkwork-ai/sdkwork-voice",
    "sourcePath": ".",
    "configPath": "agent.app.config.json"
  },
  "release": {
    "artifactPrefix": "sdkwork-voice",
    "defaultVersion": "0.1.0",
    "channels": [
      "DEV",
      "INTERNAL",
      "STABLE"
    ]
  },
  "targets": [
    {
      "id": "linux-x64-standalone-server-tar-gz",
      "platform": "linux",
      "architecture": "x64",
      "deploymentProfile": "standalone",
      "runtimeTarget": "server",
      "profile": "server",
      "formats": [
        "tar.gz"
      ],
      "runner": "ubuntu-latest",
      "outputGlobs": [
        "target/release/sdkwork-api-voice-standalone-gateway"
      ]
    },
    {
      "id": "container-x64-cloud-container-oci",
      "platform": "container",
      "architecture": "x64",
      "deploymentProfile": "cloud",
      "runtimeTarget": "container",
      "profile": "container",
      "formats": [
        "oci"
      ],
      "runner": "ubuntu-latest",
      "outputGlobs": [
        "deployments/container/sdkwork-voice-image.tar"
      ]
    }
  ],
  "dependencies": [
    {
      "id": "sdkwork-app-topology",
      "repository": "sdkwork-ai/sdkwork-app-topology",
      "refInput": "SDKWORK_APP_TOPOLOGY_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-appbase",
      "repository": "sdkwork-ai/sdkwork-appbase",
      "ref": "main",
      "refInput": "SDKWORK_APPBASE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-cloudrouter",
      "repository": "sdkwork-ai/sdkwork-cloudrouter",
      "refInput": "SDKWORK_CLOUDROUTER_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-core",
      "repository": "sdkwork-ai/sdkwork-core",
      "refInput": "SDKWORK_CORE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-database",
      "repository": "sdkwork-ai/sdkwork-database",
      "ref": "main",
      "refInput": "SDKWORK_DATABASE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-drive",
      "repository": "sdkwork-ai/sdkwork-drive",
      "ref": "main",
      "refInput": "SDKWORK_DRIVE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-iam",
      "repository": "sdkwork-ai/sdkwork-iam",
      "ref": "main",
      "refInput": "SDKWORK_IAM_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-id",
      "repository": "sdkwork-ai/sdkwork-id",
      "refInput": "SDKWORK_ID_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-sdk-commons",
      "repository": "sdkwork-ai/sdkwork-sdk-commons",
      "refInput": "SDKWORK_SDK_COMMONS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-ui",
      "repository": "sdkwork-ai/sdkwork-ui",
      "refInput": "SDKWORK_UI_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-utils",
      "repository": "sdkwork-ai/sdkwork-utils",
      "ref": "main",
      "refInput": "SDKWORK_UTILS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-web-framework",
      "repository": "sdkwork-ai/sdkwork-web-framework",
      "ref": "main",
      "refInput": "SDKWORK_WEB_FRAMEWORK_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    }
  ],
  "toolchains": {
    "node": "22",
    "pnpm": "10.33.0",
    "rust": "stable"
  },
  "lifecycle": {
    "install": [
      {
        "name": "Install dependencies",
        "shell": "bash",
        "run": "pnpm install --frozen-lockfile"
      }
    ],
    "validate": [
      {
        "name": "Run voice verification",
        "shell": "bash",
        "run": "pnpm verify"
      }
    ]
  }
}
